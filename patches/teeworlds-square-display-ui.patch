diff --git a/src/game/client/ui.cpp b/src/game/client/ui.cpp
--- a/src/game/client/ui.cpp
+++ b/src/game/client/ui.cpp
@@ -71,7 +71,14 @@ CUIRect *CUI::Screen()
 	float Aspect = Graphics()->ScreenAspect();
 	float w, h;
 
-	h = 600;
+	/* Most menu layouts contain a 730-unit-wide content area (see the
+	   settings and popup menus).  The old fixed 600-unit height makes the
+	   logical width only 600 on a square display, so those layouts extend
+	   past both sides of a 720x720 screen.  Use the dimensions reported by
+	   the active SDL video driver to enlarge the logical canvas on narrow
+	   displays.  This preserves the existing scale on 4:3/16:9 screens while
+	   making the complete menu fit on square and portrait devices. */
+	h = max(600.0f, 730.0f / Aspect);
 	w = Aspect*h;
 
 	m_Screen.w = w;
